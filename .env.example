# Copy to .env and edit.  (cp .env.example .env)

# Researcher password for /admin. If empty, one is generated on first start
# and written to data/admin-password.txt.
ONDOKU_ADMIN_PASSWORD=

# Speech engine: xtts (default) | chatterbox | dummy (no AI; tone audio, for trying the app)
ONDOKU_ENGINE=xtts

# XTTS-v2 weights are under the Coqui Public Model License (non-commercial).
# Read https://coqui.ai/cpml and set to 1 to accept.
COQUI_TOS_AGREED=0

# Where recordings, generated audio and the database are stored.
ONDOKU_DATA_DIR=data

# 127.0.0.1 = this Mac only (use with a tunnel). 0.0.0.0 = whole LAN (needs HTTPS for the mic).
ONDOKU_HOST=127.0.0.1
ONDOKU_PORT=8000

# Set to 1 when participants reach the app over HTTPS (tunnel or certificate below).
ONDOKU_SECURE_COOKIE=0

# Optional: serve HTTPS directly (e.g. LAN use with a mkcert certificate).
ONDOKU_SSL_CERTFILE=
ONDOKU_SSL_KEYFILE=

# Show generated audio to participants only after a researcher approves it (can also be changed in /admin).
ONDOKU_REQUIRE_APPROVAL=0

# Force a torch device: cpu | cuda | mps. Empty = automatic.
ONDOKU_DEVICE=
